#!/usr/bin/env bash

VERSION='v1.1'

# NOTE: this also adds the --test option, which means parse all the things, but don't actually do anything

set -e

command_exists() {
	command -v "$1" &>/dev/null
}

# requirements!
DEPENDENCIES=(bash yq)
for dep in "${DEPENDENCIES[@]}"; do
	if ! command_exists "$dep"; then
		echo "dependency '$dep' not available" >&2
		exit 1
	fi
done
if ! [[ -v VULPIX ]]; then
	echo 'VULPIX not defined' >&2
	exit 1
fi
if ! [[ -d "$VULPIX" ]]; then
	echo 'invalid directory in VULPIX' >&2
	exit 1
fi
export VULPIX="$VULPIX"

# source utils ASAP
[[ -f "$VULPIX/utils.sh" ]] && source "$VULPIX/utils.sh" || {
	echo 'failed to source $VULPIX/utils.sh' >&2
	exit 1
}
source_script "$VULPIX/src/logging.sh"
debug "using vulpix at: $VULPIX"

HELP=$"usage: vulpix [opts] [subcommand]

If run as root, applies changes at system level, else only applies at user
level. This also effects where it looks for app dirs (like configuration).

options:

  -h, --help        print help
  -v, --version     print version tag
  -b, --blueprint   specify blueprint yaml path, otherwise searches default
                    locations

subcommands:

  [none]    ...packages   Syncs system/user with blueprint. Equivalent of running
                          'clean', then 'install ...packages', then 'config
                          ...packages' subcommands, where ...packages are the
                          packages passed as args. If no packages are passed,
                          execution is the same, but the '--all' arg is appended
                          to the 'config' cmd.

  clean                   Cleans floating packages. If any packages are
                          installed but are not a package specified in blueprint
                          they will be uninstalled.

  install   ...packages   Syncs *installation* of packages with blueprint. If
                          any packages in the blueprint or args are not
                          installed, they will be installed. If a package passed
                          as an arg is not in the blueprint, it will prompt and
                          require the package to be added to the blueprint
                          before continuing. If any packages are passed,
                          installation sync will only occur for the specified
                          packages, else the entire blueprint is synced.

  config    ...packages|all Syncs *config* of packages with blueprint. It
                            always runs the global config. If any packages are
                          passed as args, it runs the config corresponding to
                          those packages. If 'all' is passed, all packages'
                          configs are ran.

  reinstall ...packages   Uninstalls then reinstalls specified packages (or all
                          packages if none specified). Prompts to add to
                          blueprint if specified packages isn't there.

  replay    <phrase>      For replaying logs of tasks for seeing what went wrong/
                          right and debugging. Searches for logs with phrase as
                          substring and prompts which log to replay if there are
                          multiple.

  dotfiles  <path>        Creates symlinks from stuff in dotfiles path
                          to all the correct locations. If <path> is not
                          supplied, uses the path in blueprint.yaml.

  edit                    Opens config directory in \$EDITOR or \$VISUAL.

  bootstrap               Updates vulpix and reruns bootstrap script. Use if you
                          1) want to update vulpix, or 2) broke something.

NOTE: ...packages are passed like package_name@manager (example: neovim@manual)."

SUBCOMMANDS=(
	'clean'
	'install'
	'config'
	'reinstall'
	'replay'
	'dotfiles'
	'edit'
	'bootstrap'
)

NO_MAIN_LOG_SUBCOMMANDS=(
	'replay'
	'edit'
	'bootstrap'
)

# parse raw arguments -----------------------------------------------------------------------------

is_test=false
blueprint_path=
dotfiles_path=
subcommand=
subcommand_args=()

first_arg_passed=false
while [[ $# -gt 0 ]]; do
	case "$1" in
	--help | -h) echo "$HELP" && exit ;;
	--version | -v) echo "$VERSION" && exit ;;
	--test) is_test=true ;;
	--blueprint | -b)
		[[ $# -ge 2 ]] || fatal 'expected arg for --blueprint'
		blueprint_path="$2"
		shift
		;;
	-*) fatal "invalid option '$1'" ;;
	*)
		if ! $first_arg_passed; then
			first_arg_passed=true
			if array_has_element SUBCOMMANDS "$1"; then
				subcommand="$1"
				shift
				continue
			fi
		fi
		subcommand_args+=("$1")
		;;
	esac
	shift
done

debug "is_test=$is_test"
debug "blueprint_path=$blueprint_path"
debug "subcommand=$subcommand"
debug "subcommand args: ${subcommand_args[@]}"

export BLUEPRINT="${blueprint_path:-$VULPIX_CONFIG/blueprint.yaml}"
info "using blueprint at '$BLUEPRINT'"

# process subcommand ------------------------------------------------------------------------------

if ! array_has_element NO_MAIN_LOG_SUBCOMMANDS "$subcommand"; then
	clear_logs
	start_log_context 'main'
	trap end_log_context EXIT
fi

replay_subcommand() {
	# source task utils
	export MAX_PROCESSES=1 TASK_SECTION_FOOTER=0 # default env var deps
	source_script "$VULPIX/src/tasks.sh"

	local phrase="${subcommand_args[*]}"
	local all_logs=() logs=()
	enum_log_files all_logs
	for log in "${all_logs[@]}"; do
		if [[ "$log" == *"$phrase"* ]]; then
			logs+=("$log")
		fi
	done

	case "${#logs[@]}" in
	0)
		[[ -z "$phrase" ]] &&
			fatal 'no logs to replay. try running a normal vulpix operation, then replaying.' ||
			fatal 'no logs matching phrase.'
		;;
	1) log_idx=0 ;;
	*)
		local log_choices=()
		get_failed_tasks
		for log in "${logs[@]}"; do
			local fancy_log="'$CYAN$log$RESET'"
			local task="$(basename "$log")"
			! array_has_element failed_tasks "$task" || fancy_log+=" (${RED}failed${RESET})"
			log_choices+=("$fancy_log")
		done
		get_choice_idx 'select log to replay: ' log_choices || fatal 'aborted'
		log_idx="$choice_idx"
		;;
	esac
	local log="${logs[$log_idx]}"

	echo "replaying '$log'"
	replay_log_file "$log" |& less -R
}

edit_subcommand() {
	local editor=${VISUAL:-$EDITOR} path=$(dirname "$BLUEPRINT")
	[[ -n "$editor" ]] || fatal "couldn't get editor; please define VISUAL or EDITOR"
	debug "editor: $editor"
	mkdir -p "$path"
	cd "$path" && "$editor" 'blueprint.yaml'
}

bootstrap_subcommand() {
	info 'running bootstrap script'
	bash "$VULPIX/bootstrap.sh"
}

dotfiles_subcommand() {
	[[ "${#subcommand_args[@]}" -le 1 ]] || fatal 'invalid number of subcommand args'
	dotfiles_path="${subcommand_args[0]}"
	if [[ -d "$dotfiles_path" ]]; then
		export DOTFILES="$dotfiles_path"
	else
		source_script "$VULPIX/src/blueprint.sh"
		if [[ -z "$DOTFILES" ]]; then
			err 'please specify dotfiles in blueprint or as arg'
			fatal 'could not find dotfiles entry in blueprint'
		fi
	fi
	debug "dotfiles=$DOTFILES"

	source_script "$VULPIX/src/dotfiles.sh"
	setup_dotfiles || fatal 'dotfiles setup failed'
}

clean=false
install=false
reinstall_instead_of_update=false
config=false
config_packages=false
SCOPE_PACKAGES=() # packages like name@manager, if empty, there's no scope (so all packages)

if [[ -z "$subcommand" ]]; then
	subcommand='clean install config' # so it falls through in case statement below
	config_packages=true
fi

case "$subcommand" in
*clean*) clean=true ;;&
*install*)
	install=true
	for arg in "${subcommand_args[@]}"; do
		array_has_element SCOPE_PACKAGES "$arg" || SCOPE_PACKAGES+=("$arg")
	done
	;;&
*config*)
	config=true
	for arg in "${subcommand_args[@]}"; do
		if [[ "$subcommand" == 'config' ]]; then
			config_packages=true # if at least one package (or all) is specified, configure packges
			if [[ "$arg" == 'all' ]]; then
				SCOPE_PACKAGES=() # no scope
				break
			fi
		fi
		array_has_element SCOPE_PACKAGES "$arg" || SCOPE_PACKAGES+=("$arg")
	done
	;;&
*reinstall*)
	# note: will have already run '*install*' case above ^^^
	reinstall_instead_of_update=true
	;;
*)
	if ! $is_test; then
		func="${subcommand}_subcommand"
		if function_exists "$func"; then
			$func
			exit $?
		fi
	fi
	;;
esac

# NOTE: from here on, we assume main execution, which is setup/config of packages

debug "clean=$clean"
debug "install=$install"
debug "reinstall=$reinstall_instead_of_update"
debug "config=$config"
debug "config_packages=$config_packages"
debug "scope: ${SCOPE_PACKAGES[@]}"

# load blueprint and parse packages ---------------------------------------------------------------

print_divider 'validating blueprint' >&3

source_script "$VULPIX/src/blueprint.sh"
source_script "$VULPIX/src/library.sh"
source_script "$VULPIX/src/tasks.sh"

if [[ "${#SCOPE_PACKAGES[@]}" -eq 0 ]]; then

	# no SCOPE_PACKAGES implies no scope (all backages)
	SCOPE_PACKAGES=("${BLUEPRINT_PACKAGES[@]}")
	debug "expanded SCOPE_PACKAGES to: ${SCOPE_PACKAGES[@]}"

else

	# look at SCOPE_PACKAGES and prompt to add to blueprint if not in BLUEPRINT_PACKAGES
	floating_scope_packages=()
	for package in "${SCOPE_PACKAGES[@]}"; do
		array_has_element BLUEPRINT_PACKAGES "$package" || floating_scope_packages+=("$package")
	done
	if [[ "${#floating_scope_packages[@]}" -gt 0 ]]; then
		debug "floating_scope_packages: ${floating_scope_packages[@]}"
		warn 'some packages were provided in scope but are not in blueprint'
		echo 'floating tasks:' >&3
		printf '  - %s\n' "${floating_scope_packages[@]}" >&3
		echo >&3
		verify "Add all of them to blueprint to continue?" >&3 ||
			fatal 'aborted... packages must be defined in blueprint'
		echo >&3

		yq_set_array '.packages' floating_scope_packages "$BLUEPRINT" --append
		BLUEPRINT_PACKAGES+=("${floating_scope_packages[@]}")
	fi

fi

managers=()

# check SCOPE_PACKAGES and sort by manager
manager_scope_packages() { echo ${1}_scope_packages; } # returns name of manager array (for namerefs)
for package in "${SCOPE_PACKAGES[@]}"; do
	parse_package "$package" || fatal "invalid package syntax at '$package' in scope"
	is_manager "$parsed_manager" || fatal "invalid manager '$parsed_manager' at '$package' in scope"

	# create and append to manager packages array
	array_name=$(manager_scope_packages "$parsed_manager")
	array_has_element managers "$parsed_manager" || managers+=("$parsed_manager")
	[[ -v $array_name ]] || declare -a $array_name
	declare -n pkgs=$array_name
	pkgs+=("$parsed_package")
done

# check BLUEPRINT_PACKAGES and sort by manager
manager_blueprint_packages() { echo ${1}_blueprint_packages; } # returns name of manager array (for namerefs)
for package in "${BLUEPRINT_PACKAGES[@]}"; do
	parse_package "$package" || fatal "invalid package syntax at '$package' in blueprint"
	is_manager "$parsed_manager" || fatal "invalid manager '$parsed_manager' at '$package' in blueprint"

	# create and append to manager packages array
	array_name=$(manager_blueprint_packages "$parsed_manager")
	array_has_element managers "$parsed_manager" || managers+=("$parsed_manager")
	[[ -v $array_name ]] || declare -a $array_name
	declare -n pkgs=$array_name
	pkgs+=("$parsed_package")
	unset -n pkgs
done

# for each manager, check 1) can use manager and 2) whether manager supports packages (both blueprint and scope)
for manager in "${managers[@]}"; do
	unset -n scope_pkgs && declare -n scope_pkgs=$(manager_scope_packages "$manager")
	unset -n bp_pkgs && declare -n bp_pkgs=$(manager_blueprint_packages "$manager")
	debug "scope packages for $manager: ${scope_pkgs[@]}"
	debug "blueprint packages for $manager: ${bp_pkgs[@]}"

	( # run in subshell to not clutter env
		load_manager "$manager"

		run_foreground_task "$(make_task_name 'can_use' "$manager")" can_use_manager ||
			fatal "cannot use '$manager' manager on your system/user"

		for package in "${scope_pkgs[@]}" "${bp_pkgs[@]}"; do
			package_is_supported "$package" || fatal "$manager manager does not support '$package'"
		done
	) || fatal 'unsupported manager/package(s) in scope or blueprint'
done

# package management ------------------------------------------------------------------------------

package_management_for_manager() {
	local manager=$1
	local -n blueprint_packages=$2
	local -n scope_packages=$3

	debug 'starting package management'
	load_manager "$manager"

	if function_exists presetup; then
		info "running $manager presetup"
		# run in foreground because it should be completed before running any manager scripts
		run_foreground_task "$(make_task_name 'presetup' "$manager")" presetup || {
			err "$manager presetup failed"
			return 1
		}
	fi

	installed_packages=()
	get_installed installed_packages
	debug "installed_packages: ${installed_packages[@]}"

	# diff between blueprint packages and installed packages
	to_install=() to_update=() to_uninstall=()
	for package in "${installed_packages[@]}"; do
		array_has_element blueprint_packages "$package" &&
			to_update+=("$package") ||
			to_uninstall+=("$package")
	done
	for package in "${blueprint_packages[@]}"; do
		array_has_element installed_packages "$package" ||
			to_install+=("$package")
	done

	debug "to_install: ${to_install[@]}"
	debug "to_update: ${to_update[@]}"
	debug "to_uninstall: ${to_uninstall[@]}"

	if [[ "${#to_uninstall[@]}" -ge "$NO_AUTO_UNINSTALL_THRESHOLD" ]]; then
		warn "manager wants to uninstall ${#to_uninstall[@]} packages"
		err "number of packages to uninstall tripped NO_AUTO_UNINSTALL_THRESHOLD ($NO_AUTO_UNINSTALL_THRESHOLD)"
		info "you can change NO_AUTO_UNINSTALL_THRESHOLD using '.no_auto_uninstall_threshold' in your blueprint"
		fatal 'manager uninstall not applied for safety'
	fi

	# apply scope
	debug 'applying scope'
	to_install_tmp=() to_update_tmp=()
	for package in "${scope_packages[@]}"; do
		if array_has_element to_install "$package"; then
			to_install_tmp+=("$package")
		elif array_has_element to_update "$package"; then
			to_update_tmp+=("$package")
		else
			fatal 'scope package not in to_install or to_update (this should not happen...)'
		fi
	done
	to_install=("${to_install_tmp[@]}")
	to_update=("${to_update_tmp[@]}")

	debug "scoped to_install: ${to_install[@]}"
	debug "scoped to_update: ${to_update[@]}"

	# test = exit before doing anything
	if $is_test; then exit; fi

	if $clean; then
		if [[ "${#to_uninstall[@]}" -gt 0 ]]; then
			info 'cleaning packages'
			uninstall_packages to_uninstall
		else
			info 'no packages to clean'
		fi
	fi

	if $install; then
		if [[ "${#to_install[@]}" -gt 0 ]]; then
			info 'installing packages'
			install_packages to_install
		else
			info 'no packages to install'
		fi

		$reinstall_instead_of_update && update_kw=reinstall || {
			update_kw=update
			update_verb=updat
		}
		if [[ "${#to_update[@]}" -gt 0 ]]; then
			info "${update_verb:-$update_kw}ing packages"
			${update_kw}_packages to_update
		else
			info "no packages to $update_kw"
		fi
	fi

	await_tasks # wait for any uninstall/install/update/reinstall tasks spawned by any managers to finish

	if function_exists postsetup; then
		info "running $manager postsetup"
		run_foreground_task "$(make_task_name 'postsetup' "$manager")" postsetup || {
			err "$manager postsetup failed"
			return 1
		}
	fi

	debug "finished package management"
}

print_task_summary() {
	if [[ ${#TASK_SUMMARY[@]} -gt 0 ]]; then
		echo 'summary:' >&3
		for task in "${!TASK_SUMMARY[@]}"; do
			local note=${TASK_SUMMARY[$task]}
			printf "  - %s%b\n" "$task" "${note:+ ($note)}" >&3
		done
		echo >&3
	fi
}

failed_packages=()

if $clean || $install; then
	print_divider 'package management' >&3
	begin_task_section 'package management' || true

	declare -A manager_pids
	for manager in "${managers[@]}"; do
		prefix="manager[$manager] "
		declare -n scope_packages=$(manager_scope_packages "$manager")
		if [[ "${#scope_packages[@]}" -gt 0 ]]; then
			# start in a subshell so manager script doesn't clutter env. start in background so multiple
			# packages from multiple managers can be installed async (src/tasks.sh handles capping running tasks).
			package_management_for_manager "$manager" \
				$(manager_blueprint_packages "$manager") \
				$(manager_scope_packages "$manager") \
				4> >(prefix_output "$prefix" >&4) \
				&
			manager_pids["$manager"]="$!"
		fi
	done

	# wait for all package_management_for_manager background processes to finish
	# NOTE: any tasks spawned by manager should be completed by the time package_management_for_manager ends via await_tasks
	for manager in "${!manager_pids[@]}"; do
		debug "waiting for '$manager' manager pid"
		wait_safe "${manager_pids["$manager"]}"
	done

	end_task_section

	# print managment tasks summary
	debug 'printing summary'
	get_all_tasks -P '^(?!can_use)' || true
	get_failed_tasks || true # no filter since no other tasks should fail before package managment
	declare -A TASK_SUMMARY=()
	for task in "${all_tasks[@]}"; do
		array_has_element failed_tasks "$task" &&
			TASK_SUMMARY[$task]="${RED}failed${RESET}" ||
			TASK_SUMMARY[$task]=
	done
	print_task_summary

	if [[ "${#failed_tasks[@]}" -gt 0 ]]; then
		warn 'some package tasks failed'
		warn 'run `vulpix replay <task>` to check task logs'
	else
		success 'all package tasks successful'
	fi

	# make note of failed packages for config (which should skip them)
	for taskname in "${failed_tasks[@]}"; do
		if parse_task_name "$taskname"; then
			if parse_package "$parsed_task_target"; then
				debug "'$parsed_package' failed ($taskname), so marking for config skip"
				failed_packages+=("$parsed_package")
			elif is_manager "$parsed_task_target"; then
				# skip all packages with manager if manager task failed
				manager=$parsed_task_target
				for package in "${SCOPE_PACKAGES[@]}"; do
					parse_package "$package"
					if [[ "$parsed_manager" == "$manager" ]]; then
						debug "'$manager' failed ($taskname), so marking '$package' for config skip"
						failed_packages+=("$parsed_package")
					fi
				done
			fi
		fi
	done

	debug 'manager stuff end'
fi

# config global, then packages --------------------------------------------------------------------

if $config; then
	print_divider 'package configuration' >&3
	source_script "$VULPIX/src/config_scripts.sh"

	# make note that failed managed packages will be skipped
	if [[ "${#failed_packages[@]}" -gt 0 ]]; then
		warn 'some package management tasks failed, so the packages will be skipped'
	fi

	to_config=('global')
	if $config_packages; then
		[[ "${#SCOPE_PACKAGES[@]}" -gt 0 ]] &&
			declare -n to_config_packages=SCOPE_PACKAGES ||
			declare -n to_config_packages=BLUEPRINT_PACKAGES
		for package in "${to_config_packages[@]}"; do
			parse_package "$package"
			if ! array_has_element failed_packages "$parsed_package"; then
				array_has_element to_config "$parsed_package" || to_config+=("$parsed_package")
			fi
		done
	fi
	debug "to_config: ${to_config[@]}"

	begin_task_section 'package configuration' || true
	(configure_packages to_config) # start in a subshell so config scripts don't clutter env
	end_task_section

	get_all_tasks -E '^config' || true
	get_failed_tasks -E '^config' || true
	declare -A TASK_SUMMARY=()
	for package in "${to_config[@]}"; do
		if [[ " ${failed_tasks[@]} " =~ " config[$package.d%.*] " ]]; then
			TASK_SUMMARY[$package]="${RED}some scripts failed${RESET}"
		elif [[ " ${all_tasks[@]} " =~ " config[$package"\.d.*"] " ]]; then
			TASK_SUMMARY[$package]=
		fi
	done
	for skipped in "${failed_packages[@]}"; do
		TASK_SUMMARY[$skipped]="${YELLOW}skipped${RESET}"
	done
	print_task_summary

	# print config tasks overall status
	if [[ ${#all_tasks[@]} -gt 0 ]]; then
		if [[ ${#failed_tasks[@]} -gt 0 ]]; then
			warn 'some config tasks failed'
			warn 'run `vulpix replay <task>` to check task logs'
		else
			success 'all config tasks successful'
		fi
	else
		warn 'no tasks were run'
	fi

	debug 'config stuff end'
fi
